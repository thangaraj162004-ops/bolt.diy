{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codeapp-ai",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Run the Worker in Mumbai, so calls to AI providers (Google) come from India and not from
  // a region they refuse ("User location is not supported"). If a deploy rejects this region,
  // use "aws:ap-south-1" (also Mumbai) instead.
  "placement": {
    "mode": "targeted",
    "region": "gcp:asia-south1"
  },
  "upload_source_maps": true
}